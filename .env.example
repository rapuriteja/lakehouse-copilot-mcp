# Copy to .env and fill in only what you use. Nothing here is needed for local mode or tests.

# ---------- Local paths ----------
DATA_DIR=data/raw
LAKEHOUSE_DIR=lakehouse

# ---------- Data generator ----------
SEED=42

# ---------- SQL engine ----------
# duckdb = local serving layer built by `lhc pipeline`, databricks = SQL warehouse + Unity Catalog
QUERY_ENGINE=duckdb
DUCKDB_PATH=lakehouse/serving.duckdb
SQL_ROW_LIMIT=200
SQL_TIMEOUT_SECONDS=20
DATABRICKS_HOST=adb-<workspace-id>.<n>.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=lakehouse_copilot

# ---------- Retrieval (RAG) ----------
# local  = TF-IDF keyword search on your laptop (free, offline)
# hybrid = TF-IDF + embeddings (vector search) merged with RRF, on your laptop
# azure  = Azure AI Search hybrid + semantic ranker
RETRIEVER=local
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=lakehouse-catalog

# ---------- Copilot LLM (OpenRouter) ----------
# openrouter = default. Without OPENROUTER_API_KEY the copilot runs offline (rule-based
#              planner, free). LLM_BASE_URL can point at any OpenAI-compatible server.
# azure      = Azure OpenAI (optional, see the block at the end)
# offline    = never call an LLM
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0

# ---------- Embeddings (for RETRIEVER=hybrid or azure) ----------
# openrouter = OpenRouter embeddings API, local = sentence-transformers on your laptop
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Key Vault (optional) ----------
# If set, keys missing from this file are read from Key Vault with your `az login`.
KEY_VAULT_URI=

# ---------- Azure OpenAI (optional, not the default) ----------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
