# Copy to .env and fill in only what you use. Nothing here is needed for local mode or tests.

# ---------- Local paths ----------
DATA_DIR=data/raw
LAKEHOUSE_DIR=lakehouse

# ---------- Data generator ----------
SEED=42

# ---------- SQL engine ----------
# duckdb = local serving layer built by `lhc pipeline`, databricks = SQL warehouse + Unity Catalog
QUERY_ENGINE=duckdb
DUCKDB_PATH=lakehouse/serving.duckdb
SQL_ROW_LIMIT=200
SQL_TIMEOUT_SECONDS=20
DATABRICKS_HOST=adb-<workspace-id>.<n>.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=lakehouse_copilot

# ---------- Retrieval (RAG) ----------
# local = TF-IDF on your laptop, azure = Azure AI Search hybrid + semantic ranker
RETRIEVER=local
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=lakehouse-catalog

# ---------- Azure OpenAI ----------
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
